rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared community posts never grant access to another user's progress or notes.
    match /questionCommunity/{bankId}/questions/{questionId}/{channel}/{postId} {
      function signedIn() { return request.auth != null; }
      function moderator() {
        return signedIn() && request.auth.token.email_verified == true
          && request.auth.token.email == 'gtsuniu@gmail.com';
      }
      function validLocation() {
        return channel in ['suggestions', 'discussion']
          && bankId.matches('^[a-zA-Z0-9_-]{1,200}$')
          && questionId.matches('^[a-zA-Z0-9_-]{1,200}$')
          && postId.matches('^[a-zA-Z0-9_-]{1,200}$');
      }
      function validPost() {
        let d = request.resource.data;
        return d.keys().hasAll(['authorId', 'authorName', 'body', 'kind', 'resolved', 'createdAt'])
          && d.keys().hasOnly(['authorId', 'authorName', 'body', 'kind', 'resolved', 'createdAt'])
          && d.authorId is string && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 80
          && d.body is string && d.body.size() > 0 && d.body.size() <= 4000
          && d.resolved is bool && d.createdAt is timestamp
          && ((channel == 'discussion' && d.kind == 'comment')
            || (channel == 'suggestions' && d.kind in ['answer', 'problem']));
      }
      allow get: if signedIn() && validLocation();
      allow list: if signedIn() && channel in ['suggestions', 'discussion']
        && request.query.limit != null && request.query.limit <= 25;
      // Posting needs a confirmed email address; reading does not.
      allow create: if signedIn() && request.auth.token.email_verified == true && validLocation() && validPost()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.resolved == false;
      // Only the moderator may change a suggestion's status; content and identity are immutable.
      allow update: if moderator() && validLocation() && channel == 'suggestions' && validPost()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if signedIn() && validLocation()
        && (resource.data.authorId == request.auth.uid || moderator());
    }
    // The opt-in leaderboard: a chosen username and this week's counts, each written only by its owner.
    match /profiles/{uid} {
      function signedIn() { return request.auth != null; }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'username', 'usernameLower', 'showLeaderboard', 'updatedAt'])
          && d.uid == uid && d.username is string && d.username.size() >= 3 && d.username.size() <= 20
          && d.usernameLower is string && d.usernameLower.size() <= 20
          && d.showLeaderboard is bool && d.updatedAt == request.time;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /leaderboard/{uid} {
      function signedIn() { return request.auth != null; }
      function owner() {
        return signedIn() && request.auth.token.email_verified == true
          && request.auth.token.email == 'gtsuniu@gmail.com';
      }
      function admin() {
        return owner() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin');
      }
      function validRow() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'week', 'count', 'sets', 'prevCount', 'prevSets', 'photo', 'visible', 'updatedAt'])
          && d.uid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 20 && d.visible is bool
          && (!('photo' in d) || (d.photo is string && d.photo.size() <= 2000 && d.photo.matches('^https://.*')))
          && d.week is string && d.week.matches('^[0-9]{4}-W[0-9]{2}$')
          && d.count is int && d.count >= 0 && d.count <= 10000
          && d.sets is int && d.sets >= 0 && d.sets <= 10000
          && d.prevCount is int && d.prevCount >= 0 && d.prevCount <= 10000
          && d.prevSets is int && d.prevSets >= 0 && d.prevSets <= 10000
          && d.updatedAt == request.time;
      }
      // Hidden rows stay readable by their owner and by admins, who follow everyone's progress.
      allow get: if signedIn() && (resource.data.visible == true || request.auth.uid == uid || admin());
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 200
        && (resource.data.visible == true || admin());
      allow create, update: if signedIn() && request.auth.uid == uid && validRow();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Study sessions: a host publishes a fixed question list under a six-digit code; friends
    // who know the code join, sit the same questions, and share their answers to compare.
    match /studySessions/{code} {
      function signedIn() { return request.auth != null; }
      function validStudy() {
        let d = request.resource.data;
        return d.keys().hasOnly(['code', 'hostUid', 'hostName', 'createdAt', 'expiresAt', 'presentations', 'questions', 'mode', 'minutes', 'readingSec', 'totalSec', 'participants'])
          && d.mode in ['practice', 'exam']
          && (!('readingSec' in d) || (d.readingSec is int && d.readingSec >= 0 && d.readingSec <= 7200))
          && (!('totalSec' in d) || (d.totalSec is int && d.totalSec >= 0 && d.totalSec <= 36000))
          && d.code == code && code.matches('^[0-9]{6}$') && d.hostUid == request.auth.uid
          && d.hostName is string && d.hostName.size() <= 40 && d.createdAt == request.time
          && d.expiresAt is int && d.presentations is list && d.presentations.size() <= 50
          && d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 60
          && d.minutes is number && d.minutes >= 0 && d.minutes <= 600
          && d.participants is list && d.participants.size() <= 50;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validStudy();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && request.resource.data.participants is list && request.resource.data.participants.size() <= 50;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      match /answers/{uid} {
        function validAnswers() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'photo', 'answers', 'sharedAt'])
            && d.uid == uid && d.name is string && d.name.size() <= 40
            && (!('photo' in d) || (d.photo is string && d.photo.size() <= 2000))
            && d.answers is list && d.answers.size() <= 60 && d.sharedAt == request.time;
        }
        allow get: if signedIn();
        allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
        allow create, update: if signedIn() && request.auth.uid == uid && validAnswers();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // Comments on one another's answers: anyone in the session reads, each writes as themselves.
      match /comments/{id} {
        function validComment() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'photo', 'index', 'targetUid', 'text', 'createdAt'])
            && d.uid == request.auth.uid && d.name is string && d.name.size() <= 40
            && (!('photo' in d) || (d.photo is string && d.photo.size() <= 2000))
            && d.index is int && d.index >= 0 && d.index < 60
            && d.targetUid is string && d.targetUid.size() <= 128
            && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
            && d.createdAt == request.time;
        }
        allow get: if signedIn();
        allow list: if signedIn() && request.query.limit != null && request.query.limit <= 500;
        allow create: if signedIn() && validComment();
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/studySessions/$(code)).data.hostUid == request.auth.uid);
      }
    }
    // Notices behind the bell: the owner and admins post, every signed-in person reads.
    match /notices/{id} {
      function signedIn() { return request.auth != null; }
      function owner() {
        return signedIn() && request.auth.token.email_verified == true
          && request.auth.token.email == 'gtsuniu@gmail.com';
      }
      function admin() {
        return owner() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin');
      }
      function validNotice() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'body', 'by', 'byUid', 'at'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.body is string && d.body.size() <= 2000
          && d.by is string && d.by.size() <= 80
          && d.byUid == request.auth.uid && d.at == request.time;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow create: if admin() && validNotice();
      allow update: if false;
      allow delete: if admin();
    }
    // Each signed-in person may read and write only their own documents.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Who has signed in. People write their own profile; only the owner reads the list and sets roles.
    match /members/{uid} {
      function signedIn() { return request.auth != null; }
      // Exactly one Google account, verified, signed in through Google.
      function owner() {
        return signedIn() && request.auth.token.email_verified == true
          && request.auth.token.email == 'gtsuniu@gmail.com'
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      // A person's own record carries the email Firebase verified for them, never a typed one.
      function ownProfile() {
        let d = request.resource.data;
        return request.auth.uid == uid
          && d.keys().hasOnly(['uid', 'email', 'name', 'photo', 'createdAt', 'lastSeenAt', 'role'])
          && d.uid == uid && d.email is string && d.email.size() <= 200
          && (d.email == request.auth.token.email || d.email == '')
          && d.name is string && d.name.size() <= 200 && d.photo is string && d.photo.size() <= 2000
          && d.lastSeenAt == request.time;
      }
      allow get: if signedIn() && (request.auth.uid == uid || owner());
      allow list: if owner() && request.query.limit != null && request.query.limit <= 500;
      allow create: if signedIn() && ownProfile() && request.resource.data.createdAt == request.time
        && !('role' in request.resource.data);
      allow update: if signedIn() && (
        (ownProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'photo', 'lastSeenAt']))
        || (owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && (!('role' in request.resource.data) || request.resource.data.role == 'admin')));
      allow delete: if false;
    }
  }
}
