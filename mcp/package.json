{
  "name": "saq-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for SAQ Practice: read and edit the shared question bank from Claude.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "saq-mcp": "bin/saq-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
