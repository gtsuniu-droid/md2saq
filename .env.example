# Cloud sync (optional). Values from the Firebase console: Project settings, Your apps, Web app.
# Set the same four in Netlify's environment variables for the live site.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Admin (optional). Google account emails allowed to see the Admin section, comma separated.
# Leave empty to show Admin to everyone (the passcode still guards it).
VITE_ADMIN_EMAILS=you@gmail.com
# Admin page, student progress: a Firebase service account key (the whole JSON on one line).
# Firebase console, Project settings, Service accounts, Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Server-side progress (optional). The whole service account key JSON on one line, in
# single quotes. From the Firebase console: Project settings, Service accounts, Generate
# new private key. Set the same variable on Netlify for the live site.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'
